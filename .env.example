# =============================================================================
# FLAPAPAY BACKEND — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# Server
PORT=3005
BASE_URL=http://localhost:3005

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flapapay
DB_USER=postgres
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=your_jwt_secret_here

# Stripe
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# CyberSource
CYBERSOURCE_MERCHANT_ID=your_merchant_id
CYBERSOURCE_KEY_ID=your_key_id
CYBERSOURCE_SECRET_KEY=your_secret_key
CYBERSOURCE_AUTH_TYPE=http_signature
CYBERSOURCE_ENVIRONMENT=apitest.cybersource.com
CYBERSOURCE_WEBHOOK_SECRET=your_webhook_secret
CYBERSOURCE_ORG_ID=your_org_id
CYBERSOURCE_FLEX_TARGET_ORIGIN=http://localhost:5173

# PawaPay
PAWAPAY_API_KEY=your_pawapay_api_key

# Resend (email)
RESEND_API_KEY=your_resend_api_key

# OpenAI (AI support)
OPENAI_API_KEY=your_openai_api_key
