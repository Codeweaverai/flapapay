# =============================================================================
# FLAPAPAY WEB — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# Backend API base URL
VITE_API_URL=http://localhost:3005

# Stripe (public key only — never put secret key here)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# CyberSource (frontend/public vars only)
VITE_CYBERSOURCE_ENVIRONMENT=sandbox
VITE_CYBERSOURCE_ORG_ID=your_org_id
VITE_CYBERSOURCE_UNIFIED_CHECKOUT_URL=https://unified.cybersource.com/assets/microform/0.11/SecureAcceptance.min.js
